<view class="container">

  <view class="top">
    <text class="title">我的宠物</text>
    <text class="since">{{since}}</text>
  </view>

  <!-- 舞台：宠物 + 气泡 + 三个触摸热区 -->
  <view class="stage">
    <view class="bubble {{bubbleOn ? 'bubble-on' : ''}}">{{say}}</view>

    <view class="pet-wrap {{anim}}">
      <image class="pet-img" src="{{petImg}}" mode="aspectFit" />
      <view class="hot hot-head" data-part="head" bindtap="onTouch"></view>
      <view class="hot hot-belly" data-part="belly" bindtap="onTouch"></view>
      <view class="hot hot-feet" data-part="feet" bindtap="onTouch"></view>
    </view>

    <text class="hint">戳戳它</text>
  </view>

  <!-- 数值：现在只是"情绪底色"，不再是压力条 -->
  <view class="stats">
    <view class="stat">
      <text class="label">饱食</text>
      <view class="bar"><view class="fill fill-hunger" style="width:{{hunger}}%"></view></view>
      <text class="val">{{hunger}}</text>
    </view>
    <view class="stat">
      <text class="label">清洁</text>
      <view class="bar"><view class="fill fill-clean" style="width:{{clean}}%"></view></view>
      <text class="val">{{clean}}</text>
    </view>
    <view class="stat">
      <text class="label">心情</text>
      <view class="bar"><view class="fill fill-mood" style="width:{{mood}}%"></view></view>
      <text class="val">{{mood}}</text>
    </view>
  </view>

  <view class="actions">
    <button class="act" data-act="feed" bindtap="onAction" disabled="{{disFeed}}">
      <text class="ico">🍖</text>
      <text class="act-label">喂食</text>
      <text class="cd">{{cdFeed}}</text>
    </button>
    <button class="act" data-act="bath" bindtap="onAction" disabled="{{disBath}}">
      <text class="ico">🛁</text>
      <text class="act-label">洗澡</text>
      <text class="cd">{{cdBath}}</text>
    </button>
    <button class="act" data-act="play" bindtap="onAction" disabled="{{disPlay}}">
      <text class="ico">🎾</text>
      <text class="act-label">陪玩</text>
      <text class="cd">{{cdPlay}}</text>
    </button>
  </view>

  <view class="entry" bindtap="goTalk">
    <text class="entry-ico">🎤</text>
    <view class="entry-text">
      <text class="entry-title">学我说话</text>
      <text class="entry-sub">按住说一句，它用怪声学你</text>
    </view>
    <text class="entry-arrow">›</text>
  </view>

  <view class="debug">
    <text class="debug-title">调试面板（上线前删掉）</text>
    <view class="debug-row">
      <button class="dbg" data-skip="3600" bindtap="onSkip">1 小时</button>
      <button class="dbg" data-skip="21600" bindtap="onSkip">6 小时</button>
      <button class="dbg" data-skip="86400" bindtap="onSkip">1 天</button>
      <button class="dbg" data-skip="259200" bindtap="onSkip">3 天</button>
    </view>
    <button class="dbg dbg-wide" bindtap="onReset">重置数据</button>
    <button class="dbg dbg-wide" bindtap="onSwitchAvatar">切换形象：{{avatar === 'cat' ? '猫' : '我'}}</button>
  </view>

</view>
