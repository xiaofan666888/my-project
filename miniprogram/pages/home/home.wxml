<view class="page">
  <view class="glow-a"></view>
  <view class="glow-b"></view>

  <view class="container">

    <view class="topbar">
      <view class="who">
        <text class="who-name">小名还没起</text>
        <text class="who-sub">{{moodText}}</text>
      </view>
      <text class="since">{{since}}</text>
    </view>

    <view class="stage">
      <view class="bubble {{bubbleOn ? 'on' : ''}}">{{say}}</view>

      <view class="pet-area">
        <view class="pet-glow"></view>

        <view class="pet-wrap {{anim}}">
          <image class="pet-img" src="{{petImg}}" mode="aspectFit" />
          <view class="hot hot-head" data-part="head" bindtap="onTouch"></view>
          <view class="hot hot-belly" data-part="belly" bindtap="onTouch"></view>
          <view class="hot hot-feet" data-part="feet" bindtap="onTouch"></view>
        </view>

        <view class="ground"></view>

        <view
          wx:for="{{particles}}"
          wx:key="id"
          class="particle"
          style="left:{{item.x}}rpx; animation-delay:{{item.delay}}ms"
        >{{item.icon}}</view>
      </view>

      <text class="hint">戳戳它</text>
    </view>

    <view class="panel">
      <view class="stat">
        <text class="stat-ico">🍖</text>
        <view class="bar"><view class="fill fill-hunger" style="width:{{hunger}}%"></view></view>
        <text class="stat-val">{{hunger}}</text>
      </view>
      <view class="stat">
        <text class="stat-ico">🫧</text>
        <view class="bar"><view class="fill fill-clean" style="width:{{clean}}%"></view></view>
        <text class="stat-val">{{clean}}</text>
      </view>
      <view class="stat">
        <text class="stat-ico">💛</text>
        <view class="bar"><view class="fill fill-mood" style="width:{{mood}}%"></view></view>
        <text class="stat-val">{{mood}}</text>
      </view>
    </view>

    <view class="actions">
      <view class="act {{disFeed ? 'off' : ''}}" data-act="feed" bindtap="onAction">
        <text class="act-ico">🍖</text>
        <text class="act-name">喂食</text>
        <text class="act-cd">{{cdFeed || '＋饱食'}}</text>
      </view>
      <view class="act {{disBath ? 'off' : ''}}" data-act="bath" bindtap="onAction">
        <text class="act-ico">🛁</text>
        <text class="act-name">洗澡</text>
        <text class="act-cd">{{cdBath || '＋清洁'}}</text>
      </view>
      <view class="act {{disPlay ? 'off' : ''}}" data-act="play" bindtap="onAction">
        <text class="act-ico">🎾</text>
        <text class="act-name">陪玩</text>
        <text class="act-cd">{{cdPlay || '＋心情'}}</text>
      </view>
    </view>

    <view class="entry" bindtap="goTalk">
      <view class="entry-ico-wrap"><text class="entry-ico">🎤</text></view>
      <view class="entry-text">
        <text class="entry-title">学我说话</text>
        <text class="entry-sub">按住说一句，它用怪声学你</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="debug">
      <text class="debug-title">调试</text>
      <view class="debug-row">
        <view class="dbg" data-skip="3600" bindtap="onSkip">1 小时</view>
        <view class="dbg" data-skip="21600" bindtap="onSkip">6 小时</view>
        <view class="dbg" data-skip="86400" bindtap="onSkip">1 天</view>
        <view class="dbg" data-skip="259200" bindtap="onSkip">3 天</view>
      </view>
      <view class="debug-row">
        <view class="dbg" bindtap="onSwitchAvatar">形象：{{avatar === 'cat' ? '猫' : '我'}}</view>
        <view class="dbg" bindtap="onReset">重置</view>
      </view>
    </view>

  </view>
</view>
