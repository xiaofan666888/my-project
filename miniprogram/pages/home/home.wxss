.container {
  padding: 24rpx 28rpx 60rpx;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.since {
  font-size: 24rpx;
  color: #8b93a7;
}

/* ============ 舞台 ============ */
.stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 0;
  margin-bottom: 20rpx;
}

.bubble {
  max-width: 520rpx;
  min-height: 68rpx;
  line-height: 44rpx;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(31, 36, 48, 0.08);
  font-size: 26rpx;
  color: #1f2430;
  text-align: center;
  opacity: 0;
  transform: translateY(10rpx) scale(0.94);
  transition: opacity 0.18s ease, transform 0.18s ease;
  pointer-events: none;
}

.bubble-on {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* 宠物本体 */
.pet-wrap {
  position: relative;
  width: 460rpx;
  height: 640rpx;
  margin-top: 8rpx;
  transform-origin: 50% 100%;
}

.pet-img {
  width: 100%;
  height: 100%;
}

/* 三个透明热区：按身体部位大致切分 */
.hot {
  position: absolute;
  left: 0;
  width: 100%;
}

.hot-head {
  top: 0;
  height: 38%;
}

.hot-belly {
  top: 38%;
  height: 37%;
}

.hot-feet {
  top: 75%;
  height: 25%;
}

.hint {
  font-size: 22rpx;
  color: #b3b9c9;
  margin-top: 4rpx;
}

/* ============ 反应动画 ============ */
.anim-head {
  animation: shake 0.5s ease;
}

.anim-belly {
  animation: squash 0.5s ease;
}

.anim-feet {
  animation: bounce 0.5s ease;
}

.anim-refuse {
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0) rotate(0deg); }
  20% { transform: translateX(-14rpx) rotate(-2deg); }
  45% { transform: translateX(12rpx) rotate(2deg); }
  70% { transform: translateX(-8rpx) rotate(-1deg); }
}

@keyframes squash {
  0%, 100% { transform: scale(1, 1); }
  35% { transform: scale(1.08, 0.92); }
  65% { transform: scale(0.96, 1.04); }
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  30% { transform: translateY(-30rpx); }
  55% { transform: translateY(0); }
  72% { transform: translateY(-12rpx); }
}

/* ============ 数值条（降级为辅助信息） ============ */
.stats {
  display: flex;
  flex-direction: column;
  margin-bottom: 28rpx;
  padding: 0 8rpx;
}

.stat {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label {
  width: 76rpx;
  font-size: 22rpx;
  color: #8b93a7;
  flex: none;
}

.bar {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: #e9ecf4;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
}

.fill-hunger { background: #ff9f43; }
.fill-clean  { background: #4bc0c0; }
.fill-mood   { background: #a06bff; }

.val {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8b93a7;
  flex: none;
}

/* ============ 三个动作 ============ */
.actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.act {
  flex: 1;
  margin: 0 8rpx;
  padding: 24rpx 0 18rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 36, 48, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.4;
}

.act::after {
  border: none;
}

.act[disabled] {
  opacity: 0.42;
}

.ico {
  font-size: 40rpx;
}

.act-label {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.cd {
  font-size: 22rpx;
  color: #8b93a7;
  min-height: 28rpx;
}

/* ============ 调试面板 ============ */
.debug {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 36, 48, 0.06);
}

.debug-title {
  display: block;
  font-size: 22rpx;
  color: #8b93a7;
  margin-bottom: 16rpx;
}

.debug-row {
  display: flex;
  justify-content: space-between;
}

.dbg {
  flex: 1;
  margin: 0 6rpx;
  padding: 0;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  color: #1f2430;
  background: #ffffff;
  border: 1rpx solid #e8ebf3;
  border-radius: 18rpx;
}

.dbg::after {
  border: none;
}

.dbg-wide {
  margin: 16rpx 6rpx 0;
  width: auto;
}
