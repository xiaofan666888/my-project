.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8f1 0%, #f4f6ff 55%, #eef1fb 100%);
  position: relative;
  overflow: hidden;
}

.glow {
  position: absolute;
  top: -160rpx;
  right: -160rpx;
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 200, 140, 0.5) 0%, rgba(255, 200, 140, 0) 68%);
}

.container {
  position: relative;
  z-index: 2;
  padding: 32rpx 32rpx 60rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.head-left {
  display: flex;
  flex-direction: column;
}

.title {
  font-size: 38rpx;
  font-weight: 600;
  color: #22202b;
}

.sub {
  font-size: 21rpx;
  color: #a3a8b8;
  margin-top: 6rpx;
}

.coin-pill {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(40, 40, 70, 0.07);
}

.coin-ico {
  font-size: 24rpx;
}

.coin-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #d98a24;
  margin-left: 8rpx;
}

.card {
  display: flex;
  align-items: center;
  padding: 24rpx 22rpx;
  margin-bottom: 18rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 30rpx rgba(40, 40, 70, 0.07);
}

.food-ico {
  font-size: 56rpx;
  width: 96rpx;
  text-align: center;
}

.food-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 12rpx;
}

.food-row {
  display: flex;
  align-items: baseline;
}

.food-name {
  font-size: 28rpx;
  color: #22202b;
  font-weight: 500;
}

.food-own {
  font-size: 19rpx;
  color: #b0b4c4;
  margin-left: 12rpx;
}

.food-desc {
  font-size: 21rpx;
  color: #9aa0b4;
  margin-top: 6rpx;
}

.food-effects {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.eff {
  font-size: 19rpx;
  color: #6f7a90;
  background: #f1f3f9;
  border-radius: 8rpx;
  padding: 3rpx 10rpx;
  margin-right: 8rpx;
  margin-top: 4rpx;
}

.eff-exp {
  color: #8f6bf0;
  background: rgba(143, 107, 240, 0.1);
}

.buy {
  width: 130rpx;
  padding: 14rpx 0;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffcf8a, #f79b3c);
  box-shadow: 0 8rpx 18rpx rgba(247, 155, 60, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.buy:active {
  transform: scale(0.95);
}

.buy.poor {
  background: #e8eaf1;
  box-shadow: none;
}

.buy-price {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.buy.poor .buy-price {
  color: #a3a8b8;
}

.buy-txt {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.buy.poor .buy-txt {
  color: #b0b4c4;
}

.tips {
  margin-top: 26rpx;
  padding: 0 10rpx;
}

.tip-line {
  display: block;
  font-size: 20rpx;
  color: #b0b4c4;
  line-height: 38rpx;
}

.back {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #6c7183;
  font-size: 26rpx;
  box-shadow: 0 10rpx 26rpx rgba(40, 40, 70, 0.06);
}

.back:active {
  background: #f2f3f8;
}
