.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #eef3ff 0%, #fdf4ec 100%);
  overflow: hidden;
}

/* 顶部计分 */
.hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 10rpx;
}

.hud-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}

.hud-label {
  font-size: 18rpx;
  color: #a3a8b8;
  letter-spacing: 2rpx;
}

.hud-val {
  font-size: 34rpx;
  font-weight: 600;
  color: #2b2a36;
  font-variant-numeric: tabular-nums;
}

.timer {
  font-size: 44rpx;
  font-weight: 700;
  color: #2b2a36;
  font-variant-numeric: tabular-nums;
}

.timer.urgent {
  color: #e8503a;
  animation: pulse 0.9s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.14); }
}

/* 场地 */
.arena {
  flex: 1;
  position: relative;
  overflow: hidden;
}

.item {
  position: absolute;
  top: -120rpx;
  font-size: 62rpx;
  line-height: 1;
  animation-name: fall;
  animation-timing-function: linear;
  animation-fill-mode: forwards;
  will-change: transform;
}

.item.bad {
  font-size: 56rpx;
}

@keyframes fall {
  0%   { transform: translateY(0) rotate(-6deg); }
  50%  { transform: translateY(50vh) rotate(6deg); }
  100% { transform: translateY(105vh) rotate(-4deg); }
}

.basket {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  margin-left: -70rpx;
  width: 140rpx;
  text-align: center;
  font-size: 76rpx;
  opacity: 0.85;
}

/* 开始遮罩 */
.overlay {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  width: 540rpx;
  padding: 44rpx 32rpx 40rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 24rpx 60rpx rgba(40, 40, 70, 0.14);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2a36;
}

.ov-sub {
  font-size: 24rpx;
  color: #8f95a6;
  margin-top: 12rpx;
}

.ov-sub.warn {
  color: #e8503a;
}

.ov-btn {
  margin-top: 32rpx;
  width: 320rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: linear-gradient(135deg, #7fb4ff, #5b7cfa);
  box-shadow: 0 12rpx 30rpx rgba(91, 124, 250, 0.32);
}

.ov-btn:active {
  transform: scale(0.96);
}

.ov-tip {
  margin-top: 20rpx;
  font-size: 19rpx;
  color: #b0b4c4;
}

/* 结算 */
.result {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 26, 40, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.res-card {
  width: 540rpx;
  padding: 48rpx 32rpx 40rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(20, 20, 40, 0.24);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.res-title {
  font-size: 30rpx;
  color: #2b2a36;
  font-weight: 600;
}

.res-score {
  font-size: 88rpx;
  font-weight: 700;
  color: #5b7cfa;
  line-height: 1.2;
  margin-top: 10rpx;
}

.res-unit {
  font-size: 28rpx;
  font-weight: 400;
  color: #9aa0b4;
}

.res-coins {
  font-size: 26rpx;
  color: #d98a24;
  margin-top: 6rpx;
}

.res-btns {
  display: flex;
  margin-top: 36rpx;
  width: 100%;
}

.res-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #7fb4ff, #5b7cfa);
  box-shadow: 0 12rpx 26rpx rgba(91, 124, 250, 0.28);
}

.res-btn.ghost {
  background: #f1f3f9;
  color: #6c7183;
  box-shadow: none;
}

.res-btn:active {
  transform: scale(0.96);
}
